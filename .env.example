# SQLite is the local default. Override this to use another compatible database later.
ML_RELEASE_DATABASE_URL=sqlite:///./ml_release_platform.db

# Local detector contract defaults. Override only for a compatible detector.
ML_RELEASE_HEALTH_PATH=/health
ML_RELEASE_INFERENCE_PATH=/infer
ML_RELEASE_STARTUP_TIMEOUT_SECONDS=30
ML_RELEASE_HEALTH_POLL_MILLISECONDS=250
ML_RELEASE_VERIFICATION_TIMEOUT_SECONDS=10
